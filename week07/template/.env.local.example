# 이 파일을 .env.local로 복사한 뒤 본인의 값으로 채우세요.
# .env.local은 .gitignore에 이미 포함되어 있어 Git에 커밋되지 않습니다.
# 절대로 실제 비밀번호/시크릿이 담긴 .env.local 파일을 GitHub에 올리지 마세요.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/websecprog?retryWrites=true&w=majority

# Auth.js가 로그인 세션(JWT)을 서명하는 데 쓰는 비밀 키입니다.
# 터미널에서 `npx auth secret`을 실행하면 자동으로 생성해 .env.local에 넣어줍니다.
AUTH_SECRET=
